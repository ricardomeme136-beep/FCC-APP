# Copy this file to .env (same folder) and adjust if needed:
#   Copy-Item .env.example .env
#
# core/db.py loads this file automatically via python-dotenv.

# --- Required ---

# MongoDB connection string. The docker-compose.yml at the repo root starts a
# local MongoDB reachable at this default URL.
MONGO_URL=mongodb://localhost:27017

# Database name used inside MongoDB (created automatically on first write).
DB_NAME=wasteflow

# Secret used to sign JWT access tokens (core/security.py). The value below is
# fine for local development only — generate your own for anything shared or
# deployed:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-local-change-me-9f2b1c7a4e6d8f0123456789abcdef0

# --- Optional (safe to leave empty for local dev) ---

# JWT signing algorithm. Matches the code default — only change if you know why.
JWT_ALGORITHM=HS256

# How many days an access token stays valid. Matches the code default.
ACCESS_TOKEN_DAYS=30

# OpenRouteService API key (services/routing.py) for real road-following route
# geometry. Leave empty to keep the existing straight-line fallback — nothing
# breaks, routes just draw as direct segments instead of following roads.
# Free key: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# LLM key for the AI assistant (routers/ai.py, POST /ai/ask). Leave empty for
# local dev — the endpoint already falls back to an "assistant unavailable"
# message instead of failing, since emergentintegrations isn't installed by
# requirements-local.txt (see that file's header for why).
EMERGENT_LLM_KEY=
