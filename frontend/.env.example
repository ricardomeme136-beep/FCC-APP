# Copy this file to .env (same folder):
#   Copy-Item .env.example .env
#
# Expo loads EXPO_PUBLIC_* variables from this file automatically — no extra
# config needed (frontend/src/api.ts reads process.env.EXPO_PUBLIC_BACKEND_URL
# directly).

# Base URL of the backend API (no trailing slash, no /api suffix — src/api.ts
# appends /api itself).
#
# - Web (npx expo start --web) or Android/iOS emulator: localhost works as-is.
# - Physical device via Expo Go, same Wi-Fi as your PC: the phone cannot
#   resolve "localhost" as your PC. Replace it with your machine's LAN IP
#   instead, e.g.:
#     EXPO_PUBLIC_BACKEND_URL=http://192.168.1.50:8000
#   Find your IP with: ipconfig  (look for "IPv4 Address")
# - Physical device off your Wi-Fi entirely (4G/5G, another network, testing
#   FASE NETWORK 1): run start-cloudflare.bat (or
#   `cloudflared tunnel --url http://localhost:8000`) — it prints a public
#   HTTPS URL, e.g.:
#     EXPO_PUBLIC_BACKEND_URL=https://random-words-here.trycloudflare.com
#   This is a free "quick tunnel": no account needed, HTTPS automatic, but
#   the URL is NOT fixed — it changes every time the tunnel restarts, so
#   development/testing only, never hardcode one. MongoDB is never exposed
#   by this tunnel — it only forwards the backend's port 8000.
#
# Whichever value you use, a full "expo start" restart is required after
# changing it — EXPO_PUBLIC_* vars are baked into the JS bundle at build/
# serve time, not read at runtime on the device. (start-frontend.bat already
# runs "expo start -c" — the -c clears the Metro cache so this is never
# stale.)
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
